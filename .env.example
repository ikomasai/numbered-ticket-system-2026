# 環境変数のサンプルファイル
# このファイルを .env にコピーして、実際の値を設定してください

# Supabase設定
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# イベント時間設定
EXPO_PUBLIC_EVENT_START_TIME=10:00
EXPO_PUBLIC_EVENT_END_TIME=19:00

# 大学祭開催日（カンマ区切り、YYYY-MM-DD形式）
EXPO_PUBLIC_FESTIVAL_DATES=2024-11-02,2024-11-03,2024-11-04

# Google Apps Script設定（オプション）
EXPO_PUBLIC_GAS_WEB_APP_URL=https://script.google.com/macros/s/your-script-id/exec

# 時間枠の配布状況表示用閾値（%）
# 25%以下: 青色、25〜50%: 緑色、50〜60%: 黄色、60〜80%: オレンジ色、80〜100%: 赤色
EXPO_PUBLIC_SLOT_THRESHOLD_LOW=xx
EXPO_PUBLIC_SLOT_THRESHOLD_MEDIUM=xx
EXPO_PUBLIC_SLOT_THRESHOLD_HIGH=xx
EXPO_PUBLIC_SLOT_THRESHOLD_VERY_HIGH=xx
